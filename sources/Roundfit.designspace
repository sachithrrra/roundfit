<?xml version='1.0' encoding='UTF-8'?>
<designspace format="5.0">
  <axes>
    <axis tag="wght" name="Weight" minimum="100" maximum="900" default="100"/>
    <axis tag="ROND" name="Roundness" minimum="0" maximum="100" default="50"/>
  </axes>
  <rules>
    <rule name="BRACKET.Weight_600_900">
      <conditionset>
        <condition name="Weight" minimum="600" maximum="900"/>
      </conditionset>
      <sub name="dollar" with="dollar.BRACKET.varAlt01"/>
      <sub name="cent" with="cent.BRACKET.varAlt01"/>
      <sub name="Dcroat" with="Dcroat.BRACKET.varAlt01"/>
    </rule>
  </rules>
  <sources>
    <source filename="Roundfit-Thin-ROND0.ufo" name="Roundfit Thin ROND0" familyname="Roundfit" stylename="Thin">
      <location>
        <dimension name="Weight" xvalue="100"/>
        <dimension name="Roundness" xvalue="0"/>
      </location>
    </source>
    <source filename="Roundfit-Thin-ROND50.ufo" name="Roundfit Thin ROND50" familyname="Roundfit" stylename="Thin">
      <lib copy="1"/>
      <groups copy="1"/>
      <features copy="1"/>
      <info copy="1"/>
      <location>
        <dimension name="Weight" xvalue="100"/>
        <dimension name="Roundness" xvalue="50"/>
      </location>
    </source>
